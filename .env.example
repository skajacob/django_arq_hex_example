SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# Local development without Docker (hosts point to 127.0.0.1).
# Docker uses env/*.env.example instead, one file per service.

# Database
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=cheaf-db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_NAME=0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
