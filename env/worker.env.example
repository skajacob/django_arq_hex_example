# Worker container (Celery worker + beat). Same as backend.env plus email,
# because only the worker sends notifications.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=cheaf-db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email notifications (use the console backend to just print them)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
