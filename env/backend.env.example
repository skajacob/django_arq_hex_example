# Backend container (Django + gunicorn)
# Development defaults. For production: DEBUG=False, a long random SECRET_KEY,
# explicit ALLOWED_HOSTS and strong credentials.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# Database (service name of the db container). Must match db.env
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=cheaf-db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Celery broker, used to enqueue tasks (service name of the redis container)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
